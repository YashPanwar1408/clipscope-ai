# ClipScope AI — Environment variables
# Copy this file to .env and fill in your values.
# Never commit real secrets. .env is gitignored.

# ─── Supabase (required for authentication and data) ─────────────────────
# Public values. The publishable/anon key is expected to be visible to the
# browser; database security is enforced by Row Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_anon_key_your_public_key_here

# ─── Server-only credentials (never expose in browser code) ──────────────
# Required for AI analysis, comparisons, and research chat (free Groq tier).
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Required for YouTube Shorts metadata retrieval.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Required for Instagram Reels metadata retrieval via Instagram Looter on RapidAPI.
RAPIDAPI_KEY=your_rapidapi_key

# Required for durable background workflows (Inngest).
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# Required for background Inngest workers to write to RLS-protected tables.
# Server-only. Do not add this to .env.local unless running workers locally.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
